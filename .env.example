# Server
PORT=8787
HOST=127.0.0.1

# Rendering engine
# Path to a Chromium executable. Leave blank to use Playwright's bundled Chromium.
CHROMIUM_EXECUTABLE_PATH=
# Max concurrent render browser contexts. Requests above the limit are rejected.
# Valid positive integer.
RENDER_CONCURRENCY=4
# Default per-render timeout in milliseconds when a request omits timeoutMs.
# Per-request timeoutMs overrides this value. Valid integer: 1000-120000.
RENDER_TIMEOUT_MS=30000
# Max accepted request body size (e.g. 2mb).
MAX_REQUEST_BYTES=2mb
# Allow URL capture feature (disabled by default for safety).
ENABLE_URL_CAPTURE=true
# Comma-separated extra hosts to allow for URL capture beyond the public-suffix allowlist.
URL_ALLOWED_HOSTS=
# Comma-separated hosts to always block for URL capture.
URL_BLOCKED_HOSTS=